# ============================================================
# PersonDB — Environment Configuration
# Copy to .env and customize
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-to-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database: "postgresql" or "sqlite"
DB_ENGINE=postgresql
DB_NAME=persondb
DB_USER=persondb
DB_PASSWORD=strong-password-here
DB_HOST=db
DB_PORT=5432

# Locale
LANGUAGE_CODE=cs
TIME_ZONE=Europe/Prague

# Theme: matrix | cyberpunk | minimal | light
PERSONDB_THEME=matrix

# Ports
APP_PORT=8000
NGINX_PORT=80

# Pagination
ITEMS_PER_PAGE=24
